.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env

# Database
*.db
*.sqlite
*.sqlite3

# Logs generales (*.log)
*.log
# La carpeta logs/ se gestiona más abajo con logs/* y logs/.gitkeep

# OS
.DS_Store
Thumbs.db
desktop.ini

# Archivos subidos (opcional - quitar si quieres incluir archivos de ejemplo)
archivos/fotos/*
archivos/pdfs/*
archivos/evidencias/*
# Mantener las carpetas vacías
!archivos/fotos/.gitkeep
!archivos/pdfs/.gitkeep
!archivos/evidencias/.gitkeep

# Respaldos
respaldos/

# Logs del servicio (NSSM stdout/stderr)
logs/*
!logs/.gitkeep

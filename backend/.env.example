# ============================================================
#  Configuración del backend RCA
#  Copia este archivo a ".env" (sin ".example") y edita los valores.
#  El instalador (instalar.bat) hace la copia automáticamente.
# ============================================================

# ---------------- Base de datos (MySQL / XAMPP) ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rca_database

# ---------------- Servidor ----------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8007

# ---------------- Rutas ----------------
# Relativas a la raíz del proyecto, o rutas absolutas (C:/...).
ARCHIVOS_PATH=../archivos
RESPALDOS_PATH=../respaldos
LOGS_PATH=../logs

# ---------------- Seguridad (JWT) ----------------
# Déjalo vacío: al arrancar se generará una clave aleatoria y se guardará aquí.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------- CORS ----------------
# Orígenes permitidos separados por coma. Usa * solo en desarrollo.
# Ej: http://192.168.38.14:8007,http://localhost:8007
CORS_ORIGINS=*

# ---------------- Subida de archivos ----------------
MAX_UPLOAD_MB=25